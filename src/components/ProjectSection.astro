---
interface Props {
  id: string;
  title: string;
  accent?: 'teal' | 'coral' | 'peach' | 'pink' | 'sage' | 'sky';
}

const { id, title, accent = 'teal' } = Astro.props;

const bgClass = {
  teal:  'bg-poster-teal/8',
  coral: 'bg-poster-coral/8',
  peach: 'bg-poster-peach/10',
  pink:  'bg-poster-pink/10',
  sage:  'bg-poster-sage/10',
  sky:   'bg-poster-sky/10',
}[accent];

const marks = [
  `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12 21C12 21 5 14 5 9C5 5.7 8 3 12 3C16 3 19 5.7 19 9C19 14 12 21 12 21Z" stroke="currentColor" stroke-width="1.5" fill="none"/><line x1="12" y1="21" x2="12" y2="10" stroke="currentColor" stroke-width="1.5"/></svg>`,
  `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="12" cy="12" r="2.5" stroke="currentColor" stroke-width="1.5"/><ellipse cx="12" cy="6" rx="2" ry="3" stroke="currentColor" stroke-width="1.2"/><ellipse cx="12" cy="18" rx="2" ry="3" stroke="currentColor" stroke-width="1.2"/><ellipse cx="6" cy="12" rx="3" ry="2" stroke="currentColor" stroke-width="1.2"/><ellipse cx="18" cy="12" rx="3" ry="2" stroke="currentColor" stroke-width="1.2"/></svg>`,
  `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12 20V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M12 14C12 14 8 11 7 7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><path d="M12 11C12 11 16 8 17 4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>`,
];

const markIndex = ['teal','coral','peach','pink','sage','sky'].indexOf(accent) % 3;
const mark = marks[markIndex];
---

<section id={id} class={bgClass} style="padding-block: 2rem" aria-labelledby={`${id}-heading`}>
  <div class="container" style="max-width: 68ch">
    <div class="mb-5">
      <span class="text-accent opacity-60" set:html={mark} />
      <h2
        id={`${id}-heading`}
        class="font-display font-medium text-ink tracking-tight mt-2"
      >
        {title}
      </h2>
    </div>
    <div class="space-y-4 font-body text-ink leading-relaxed">
      <slot />
    </div>
  </div>
</section>
