---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<blockquote class="my-6" style="border-left: 3px solid var(--color-accent); padding-inline-start: var(--space-lg); max-width: 60ch">
  <p class="font-display italic text-ink" style="font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem); line-height: 1.45; font-weight: 400">
    {text}
  </p>
</blockquote>
