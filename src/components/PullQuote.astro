---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<blockquote class="my-12">
  <div class="w-12 h-0.5 bg-accent mb-6" aria-hidden="true"></div>
  <p class="font-display font-medium text-3xl md:text-4xl text-ink leading-snug tracking-tight italic">
    {text}
  </p>
</blockquote>
