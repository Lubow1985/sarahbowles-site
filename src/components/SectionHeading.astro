---
interface Props {
  title: string;
  eyebrow?: string;
}

const { title, eyebrow } = Astro.props;
---

<div class="space-y-2">
  {eyebrow && (
    <p class="font-body text-sm font-medium text-muted uppercase tracking-widest">
      {eyebrow}
    </p>
  )}
  <h2 class="font-display font-medium text-2xl md:text-3xl text-ink tracking-tight">
    {title}
  </h2>
</div>
