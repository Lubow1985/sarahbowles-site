---
interface Props {
  title: string;
  description: string;
  href: string;
  accent?: boolean;
}

const { title, description, href, accent = false } = Astro.props;
---

<a
  href={href}
  class={`card${accent ? ' border-l-4 border-l-poster-teal' : ''}`}
>
  <h2 class="font-display font-medium text-ink mb-2" style="font-size: var(--fs-h3)">
    {title}
  </h2>
  <p class="font-body text-muted leading-relaxed" style="font-size: var(--fs-body)">
    {description}
  </p>
</a>
