---
const year = new Date().getFullYear();

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Research', href: '/research' },
  { label: 'Contact', href: '/contact' },
];
---

<footer class="border-t border-border py-12 mt-auto">
  <div class="max-w-5xl mx-auto px-6 md:px-8 text-center space-y-4">
    <p class="font-body text-sm text-subtle">&copy; Sarah Bowles {year}</p>
    <p class="font-body text-sm text-subtle">
      Currently training at the Salomons Institute for Applied Psychology,<br />
      Canterbury Christ Church University.
    </p>
    <nav aria-label="Footer navigation" class="flex flex-wrap justify-center items-center gap-x-3 gap-y-2">
      {navLinks.map(({ label, href }, i) => (
        <>
          {i > 0 && <span class="text-subtle text-sm select-none" aria-hidden="true">·</span>}
          <a
            href={href}
            class="font-body text-sm text-subtle hover:text-ink transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            {label}
          </a>
        </>
      ))}
    </nav>
  </div>
</footer>
