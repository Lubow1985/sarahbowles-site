---
interface Props {
  title: string;
  eyebrow?: string;
  strapline?: string;
}

const { title, eyebrow, strapline } = Astro.props;
---

<div class="border-b border-border">
  <div class="container" style="padding-top: 2.5rem; padding-bottom: 2rem">
    {eyebrow && (
      <p class="font-body text-sm font-medium text-muted uppercase tracking-widest mb-3">
        {eyebrow}
      </p>
    )}
    <h1 class="font-display tracking-tight text-ink">
      {title}
    </h1>
    {strapline && (
      <p class="mt-4 font-body text-base md:text-lg text-muted leading-relaxed" style="max-width: 68ch">
        {strapline}
      </p>
    )}
  </div>
</div>
