---
interface Props {
  title: string;
  eyebrow?: string;
  strapline?: string;
}

const { title, eyebrow, strapline } = Astro.props;
---

<div class="border-b border-border">
  <div class="max-w-5xl mx-auto px-6 md:px-8 py-20 md:py-28">
    {eyebrow && (
      <p class="font-body text-sm font-medium text-muted uppercase tracking-widest mb-4">
        {eyebrow}
      </p>
    )}
    <h1 class="font-display font-semibold text-4xl md:text-5xl lg:text-6xl tracking-tight text-ink">
      {title}
    </h1>
    {strapline && (
      <p class="mt-6 font-body text-lg md:text-xl text-muted leading-relaxed max-w-2xl">
        {strapline}
      </p>
    )}
  </div>
</div>
