---
interface Props {
  name: string;
  role: string;
}

const { name, role } = Astro.props;
---

<article class="card">
  <header class="mb-3">
    <p class="font-body font-medium text-muted uppercase tracking-widest mb-1" style="font-size: var(--fs-small)">{role}</p>
    <h3 class="font-display font-medium text-ink tracking-tight" style="font-size: var(--fs-h3)">{name}</h3>
  </header>
  <div class="space-y-3 font-body text-ink leading-relaxed" style="font-size: var(--fs-body)">
    <slot />
  </div>
</article>
