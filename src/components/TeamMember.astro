---
interface Props {
  name: string;
  role: string;
}

const { name, role } = Astro.props;
---

<article class="bg-surface border border-border rounded-lg p-6 md:p-8">
  <header class="mb-4">
    <p class="font-body text-sm font-medium text-muted uppercase tracking-widest mb-1">{role}</p>
    <h3 class="font-display font-medium text-xl md:text-2xl text-ink tracking-tight">{name}</h3>
  </header>
  <div class="space-y-4 font-body text-base text-ink leading-relaxed">
    <slot />
  </div>
</article>
