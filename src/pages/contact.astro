---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Sarah Bowles, Trainee Clinical Psychologist."
  pathname="/contact"
>
  <PageHero title="Contact" />

  <div class="container" style="padding-top: 2rem; padding-bottom: 2.5rem">
    <div style="max-width: 68ch" class="space-y-6">
      <p class="font-body text-muted leading-relaxed" style="font-size: var(--fs-body)">
        The best way to reach Sarah is by email.
      </p>

      <a
        href="mailto:sb2144@canterbury.ac.uk"
        class="block font-display font-medium text-accent transition-colors"
        style="font-size: var(--fs-h2); text-decoration: none"
      >
        sb2144@canterbury.ac.uk
      </a>

      <p class="font-body text-muted leading-relaxed" style="font-size: var(--fs-body)">
        Sarah typically responds within a few working days.
      </p>

      <p class="font-body text-muted leading-relaxed border-t border-border pt-6" style="font-size: var(--fs-small)">
        For matters relating to the Growth-Oriented Practice in Psychosis study, the same email
        applies. Concerns about the conduct of the study can be raised with Sarah's primary
        supervisor, Dr Anne Cooke, at <a href="mailto:anne.cooke@canterbury.ac.uk">anne.cooke@canterbury.ac.uk</a>.
      </p>
    </div>
  </div>
</BaseLayout>
