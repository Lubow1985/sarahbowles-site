---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`CV — ${SITE_TITLE}`}
			description="Curriculum vitae of Sarah Bowles, Trainee Clinical Psychologist."
		/>
	</head>
	<body>
		<Header />
		<main>
			<h1>CV</h1>
			<div class="placeholder" style="display: block; padding: 3rem 2rem; text-align: center; font-size: 1.1rem;">
				[PLACEHOLDER: Image or PDF of Sarah's CV — to be added]
			</div>
		</main>
		<Footer />
	</body>
</html>
