---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { url } from '../utils/paths';
---

<!doctype html>
<html lang="en-GB">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero-intro {
				max-width: 65ch;
				line-height: 1.75;
				margin-bottom: 3rem;
				color: var(--color-text-muted);
			}
			.path-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1.25rem;
				margin-bottom: 2.5rem;
			}
			.path-card {
				display: block;
				padding: 1.5rem;
				border: 1px solid var(--color-border);
				border-radius: 12px;
				text-decoration: none;
				background-color: var(--color-bg-offset);
				transition: border-color 0.2s, box-shadow 0.2s;
			}
			.path-card:hover {
				border-color: var(--color-accent);
				box-shadow: var(--shadow-md);
				text-decoration: none;
			}
			.path-card-title {
				font-weight: 700;
				color: var(--color-text-main);
				display: block;
				margin-bottom: 0.5rem;
				font-size: 1.05rem;
			}
			.path-card-desc {
				font-size: 0.9rem;
				color: var(--color-text-muted);
				margin: 0;
				line-height: 1.6;
			}
			.callout {
				border-left: 3px solid var(--color-accent);
				background-color: var(--color-bg-offset);
				padding: 1.25rem 1.5rem;
				border-radius: 0 8px 8px 0;
				font-size: 0.95rem;
				color: var(--color-text-muted);
				line-height: 1.75;
			}
			.callout a {
				color: var(--color-accent);
			}
			@media (max-width: 640px) {
				.path-grid { grid-template-columns: 1fr; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<span class="page-eyebrow">A doctoral research project</span>
			<h1 class="page-title">Growth-Oriented Practice in Psychosis</h1>
			<p class="page-strapline">What helps people grow through and beyond experiences of psychosis — and how can clinicians support that growth?</p>
			<p class="hero-intro">This site introduces an ongoing doctoral research project at the Salomons Institute for Applied Psychology, Canterbury Christ Church University. The project explores how mental health professionals understand growth following psychosis and how they can recognise, protect and support it in clinical practice.</p>

			<div class="path-grid">
				<a href={url('/background')} class="path-card">
					<span class="path-card-title">Background to the Research</span>
					<p class="path-card-desc">The growing evidence base for positive changes following psychosis, and why a broader model of growth is needed.</p>
				</a>
				<a href={url('/project')} class="path-card">
					<span class="path-card-title">The Research Project</span>
					<p class="path-card-desc">Aims, research questions, methods, and how mental health professionals can take part.</p>
				</a>
				<a href={url('/team')} class="path-card">
					<span class="path-card-title">Research Team</span>
					<p class="path-card-desc">The lead researcher and supervisors behind the project.</p>
				</a>
				<a href={url('/ethics')} class="path-card">
					<span class="path-card-title">Ethical Approval</span>
					<p class="path-card-desc">How the study has been reviewed, and how participants are protected.</p>
				</a>
			</div>

			<div class="callout">
				The study is actively recruiting mental health professionals who aim to support clients to learn and grow from experiences of psychosis. If that describes your practice, please see <a href={url('/project')}>The Research Project</a> page for details.
			</div>
		</main>
		<Footer />
	</body>
</html>
