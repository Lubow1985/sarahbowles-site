---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
---

<BaseLayout
  title="Research"
  description="Sarah Bowles's research focuses on what supports growth following psychosis, asking how mental health professionals can recognise and facilitate this in clinical practice."
  pathname="/research"
>
  <PageHero title="Research" />

  <div class="container space-y-8" style="padding-top: 2rem; padding-bottom: 2.5rem">

    <p class="font-body text-base md:text-lg text-muted leading-relaxed max-w-prose">
      My research focuses on what supports growth following psychosis. While experiences of
      psychosis can be deeply distressing, a growing body of evidence shows that many people
      also experience meaningful positive changes in the aftermath. These changes can show up
      in relationships, in sense of self, and in life direction. My current doctoral research
      asks how mental health professionals can recognise and support this kind of growth in
      clinical practice.
    </p>

    <!-- Featured project card -->
    <a
      href="/research/growth-oriented-practice-in-psychosis"
      class="block bg-surface border border-border border-l-4 border-l-poster-teal rounded-lg p-6 md:p-10 hover:border-border-strong transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      aria-label="Read about Growth-Oriented Practice in Psychosis, current doctoral research"
    >
      <p class="font-body text-sm font-medium text-muted uppercase tracking-widest mb-3">
        Current doctoral research
      </p>
      <h2 class="font-display font-semibold text-2xl md:text-3xl text-ink tracking-tight mb-4">
        Growth-Oriented Practice in Psychosis
      </h2>
      <p class="font-body text-base md:text-lg text-muted leading-relaxed max-w-2xl">
        A grounded-theory study exploring how mental health professionals understand growth
        following psychosis and how they support it in clinical practice. Salomons Institute for
        Applied Psychology, Canterbury Christ Church University.
      </p>
    </a>

    <!-- Future projects placeholder -->
    <!-- Future projects will appear here as additional cards. -->

  </div>
</BaseLayout>
