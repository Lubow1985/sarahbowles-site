---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';

interface Props {
  title: string;
  description?: string;
  pathname: string;
}

const {
  title,
  description = 'Sarah Bowles, Trainee Clinical Psychologist. Researching how mental health professionals can support growth following psychosis.',
  pathname,
} = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Sarah Bowles" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEO title={title} description={description} path={pathname} />
  </head>
  <body class="bg-bg text-ink font-body antialiased min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-accent focus:text-white focus:rounded-md focus:text-sm"
    >
      Skip to content
    </a>
    <Header pathname={pathname} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
